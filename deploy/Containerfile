FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV PUPPETEER_SKIP_DOWNLOAD=true NEXT_TELEMETRY_DISABLED=1
COPY full-app/package.json full-app/package-lock.json ./
RUN npm ci
COPY full-app/ ./
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 LEADFACTORY_DATA_MODE=local NEXT_PUBLIC_LEADFACTORY_DATA_MODE=local LEADFACTORY_ENABLE_EXTERNAL=0 LEADFACTORY_CONNECT_DATABASE=0
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 14320
CMD ["node", "node_modules/next/dist/bin/next", "start", "-H", "0.0.0.0", "-p", "14320"]
